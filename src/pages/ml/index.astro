---
import HomeLayout from '../../layouts/HomeLayout.astro';
import Navigation from '../../components/shared/Navigation.astro';
import PersonalHero from '../../components/home/PersonalHero.astro';
import BusinessGrid from '../../components/home/BusinessGrid.astro';
import { personInfoMl as personInfo, businessesMl as businesses } from '../../config/site.ml';
import type { StructuredData } from '../../types/seo';

const locale = 'ml';
const siteUrl = Astro.site ?? new URL('https://nijojohny.com');
const title = `${personInfo.name} | കോതമംഗലത്തെ ഇ-ഗവേണൻസ്, നികുതി & ഇൻഷുറൻസ് സേവനങ്ങൾ`;
const description = 'കോതമംഗലത്ത് ഇ-ഗവേണൻസ്, നികുതി, അക്കൗണ്ടിംഗ്, ഇൻഷുറൻസ് ആവശ്യങ്ങൾക്ക് നിജോ ജോണിയുടെ വിശ്വസനീയമായ സഹായം.';
const socialProfiles = Object.values(personInfo.social ?? {}).filter(Boolean);

// Generate structured data for Person
const structuredData: StructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl.href}#person`,
  'name': personInfo.name,
  'url': siteUrl.href,
  'image': new URL(personInfo.photo || '/images/nijo-johny.jpg', siteUrl).href,
  'jobTitle': personInfo.title,
  'description': personInfo.bio,
  'telephone': personInfo.contact.phone,
  'email': personInfo.contact.email,
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'Kothamangalam',
    'addressRegion': 'Kerala',
    'addressCountry': 'IN'
  },
  ...(socialProfiles.length > 0 && { 'sameAs': socialProfiles }),
  'owns': businesses.map(business => ({
    '@type': 'Organization',
    '@id': `${new URL(`/${business.slug}/`, siteUrl).href}#business`,
    'name': business.name,
    'url': new URL(`/${business.slug}/`, siteUrl).href
  }))
};
---

<HomeLayout
  title={title}
  description={description}
  locale={locale}
  structuredData={structuredData}
  ogImage="/images/og-nijo-johny.jpg"
  ogImageAlt="നിജോ ജോണി — കോതമംഗലത്തെ ഇ-ഗവേണൻസ്, നികുതി, ഇൻഷുറൻസ് സേവനങ്ങൾ"
>
  <!-- Navigation -->
  <Navigation currentPath="/ml/" locale={locale} />

  <main>
    <!-- Personal Hero Section -->
    <PersonalHero person={personInfo} locale={locale} />

    <!-- Business Grid Section -->
    <BusinessGrid locale={locale} />
  </main>

  <!-- Footer -->
  <footer class="bg-gradient-to-b from-primary-dark to-black text-white py-12 border-t-4 border-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="text-xl font-bold mb-2">{personInfo.name}</p>
        <p class="text-secondary text-lg mb-6">{personInfo.title}</p>
        <div class="flex justify-center gap-6 mb-6 flex-wrap">
          <a href={`tel:${personInfo.contact.phone}`} class="hover:text-secondary transition-colors font-semibold text-white">
            📞 {personInfo.contact.phone}
          </a>
          <span class="text-gray-500">|</span>
          <a href={`mailto:${personInfo.contact.email}`} class="hover:text-secondary transition-colors font-semibold text-white">
            ✉️ {personInfo.contact.email}
          </a>
        </div>
        {personInfo.social.facebook && (
          <div class="mb-6">
            <a
              href={personInfo.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 bg-accent-facebook text-white font-semibold rounded-lg hover:opacity-90 transition-all shadow-lg hover:shadow-xl hover:scale-105"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              ഫേസ്ബുക്കിൽ പിന്തുടരുക
            </a>
          </div>
        )}
        <p class="text-sm text-gray-400">© 2026 {personInfo.name}. എല്ലാ അവകാശങ്ങളും സംരക്ഷിച്ചിരിക്കുന്നു.</p>
      </div>
    </div>
  </footer>
</HomeLayout>
