---
import '../styles/global.css';
import type { StructuredData } from '../types/seo';

interface Props {
  title: string;
  description: string;
  locale?: string;
  structuredData?: StructuredData | StructuredData[];
  ogImage?: string;
  ogImageAlt?: string;
  canonical?: string;
  includeFacebookSdk?: boolean;
}

const {
  title,
  description,
  locale = 'en',
  structuredData,
  ogImage = '/images/og-nijo-johny.jpg',
  ogImageAlt = title,
  canonical,
  includeFacebookSdk = false
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const siteUrl = Astro.site ?? new URL('https://nijojohny.com');
const fullUrl = canonical
  ? new URL(canonical, siteUrl).href
  : new URL(Astro.url.pathname, siteUrl).href;
const fullOgImage = new URL(ogImage, siteUrl).href;

// Alternate language URLs
const englishPath = locale === 'ml'
  ? Astro.url.pathname.replace(/^\/ml(?=\/|$)/, '') || '/'
  : Astro.url.pathname;
const malayalamPath = englishPath === '/' ? '/ml/' : `/ml${englishPath}`;
const englishUrl = new URL(englishPath, siteUrl).href;
const malayalamUrl = new URL(malayalamPath, siteUrl).href;
const alternateLocale = locale === 'en' ? 'ml_IN' : 'en_IN';
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#282c6d" />

    <!-- Favicons -->
    <link rel="shortcut icon" href={`${baseUrl.replace(/\/$/, '')}/favicon.ico`} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl.replace(/\/$/, '')}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${baseUrl.replace(/\/$/, '')}/favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl.replace(/\/$/, '')}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${baseUrl.replace(/\/$/, '')}/site.webmanifest`} />

    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Canonical URL -->
    <link rel="canonical" href={fullUrl} />

    <!-- Alternate Languages -->
    <link rel="alternate" hreflang="en-IN" href={englishUrl} />
    <link rel="alternate" hreflang="ml-IN" href={malayalamUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nijo Johny" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'ml_IN'} />
    <meta property="og:locale:alternate" content={alternateLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    {structuredData && (
      Array.isArray(structuredData)
        ? structuredData.map(data => (
            <script type="application/ld+json" set:html={JSON.stringify(data)} />
          ))
        : <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SE3GW2DZJV"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SE3GW2DZJV');
    </script>

    {includeFacebookSdk && (
      <>
        <!-- Facebook SDK -->
        <script is:inline>
          window.fbAsyncInit = function() {
            FB.init({
              xfbml: true,
              version: 'v18.0'
            });
          };
        </script>
        <script async defer crossorigin="anonymous"
          src="https://connect.facebook.net/en_US/sdk.js"></script>
      </>
    )}
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>
