---
import BaseLayout from './BaseLayout.astro';
import type { StructuredData } from '../types/seo';

interface Props {
  title: string;
  description: string;
  locale?: string;
  structuredData?: StructuredData | StructuredData[];
  ogImage?: string;
  ogImageAlt?: string;
}

const { title, description, locale = 'en', structuredData, ogImage, ogImageAlt } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  structuredData={structuredData}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <slot />
</BaseLayout>
